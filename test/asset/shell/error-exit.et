test Default:
    node n
    shell on n as sh:
        false

test DisabledSuccess:
    node n
    shell on n as sh:
        set +e
        false
        true

test DisabledFailure:
    node n
    shell on n as sh:
        set +e
        false

test Enabled:
    node n
    shell on n as sh:
        set +e
        false
        set -e
        false
        true
